# ============================================================
# 通用忽略规则（跨语言起点，按项目需要增删）
# 参考：https://git-scm.com/docs/gitignore
# ============================================================

# ---------- 操作系统 / Windows ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
System Volume Information/
*.lnk
.DS_Store

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.history/
.obsidian/workspace*.json

# ---------- Office / 临时文件 ----------
~$*
*.tmp
*.temp
*.bak
tmp/
temp/

# ---------- 日志 ----------
*.log
logs/

# ---------- 密钥 / 本地私有配置（绝不要提交）----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json

# ---------- 敏感文档 / 凭据类文件（防止再次误提交）----------
# 文件名含敏感关键词的，一律不跟踪（中英文都覆盖）
*激活码*
*序列号*
*注册码*
*密码*
*口令*
*密钥*
*凭证*
*license*
# Office 文档：多为本地二进制资料，一般不属于版本库内容
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
# 其他证书 / 密钥容器格式
*.pfx
*.jks
*.keystore
# 说明：以上规则按文件名/扩展名匹配，如需强制加入某个文件用 git add -f <文件>；
#      如需为某目录放行，加一条例外规则，例如：!docs/设计文档.docx

# ---------- 构建产物 / 缓存 ----------
build/
dist/
out/
coverage/
.cache/
*.tsbuildinfo

# ---------- Git 工作树（git worktree add 的目标目录）----------
.worktrees/

# ---------- Node.js / TypeScript ----------
node_modules/
.pnpm-store/
.npm/
.next/
.nuxt/
.yarn/cache/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------- 大文件 / 数据（如需忽视，取消下面注释）----------
# *.zip
# *.7z
# *.iso
# data/
# *.csv
